# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environment
.venv/

# Secrets (API keys, storage credentials)
.env

# Jupyter
.ipynb_checkpoints/

# Data: audio, embeddings, database. Only the song catalog is tracked.
/data/*
!/data/catalog.csv

# Essentia model files
/models/

# Audio and database files
*.mp3
*.wav
*.flac
*.aac
*.m4a
*.ogg
*.db
*.sqlite
*.sqlite3
# The website's copies of the songs (written by scripts/build_catalog.py): a clone of the private
# repository OsloHaggadone/synopsist-audio, so a song taken off the site is in no public repository
# (scripts/push_songs.sh pushes them; the site's publishing reads them from there)
/player/library/audio/

# Windows metadata created when copying files into WSL
*:Zone.Identifier

# the Worker's (worker/): its packages, wrangler's local state, local-only settings
/worker/node_modules/
/worker/.wrangler/
/worker/.dev.vars

# Claude Code's settings: kept on this computer, not on GitHub
.claude/
